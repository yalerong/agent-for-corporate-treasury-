# 企业资金智能体环境变量模板
# 用法：复制为 .env 后填入真实值。.env 已在 .gitignore，绝不入库。

# ── LLM 配置 ──────────────────────────────────────────────────
# provider: openai / qwen / deepseek（任一兼容 OpenAI 协议的供应商）
LLM_PROVIDER=qwen
LLM_MODEL=qwen-max
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.0

# 备选示例（取消注释并把上面对应项注释即可切换）：
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
#
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
#
# Claude 官方 SDK 通道（cashflow/llm_client.py：provider=anthropic 时凭据走 ANTHROPIC_API_KEY）：
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# ── cashflow 数据核心 ────────────────────────────────────────
# 数据根目录（缺省=cashflow/ 代码同目录）；测试与 demo 用它指向临时目录
CASHFLOW_ROOT=
# finweb 余额接口直取（ingest_balances_api.py），走导出 Excel 则不用填
FINWEB_BASE_URL=
FINWEB_TOKEN=
# fetch_finweb.py 自动登录（替代手贴 FINWEB_TOKEN）：账号密码 + TOTP；TOTP_SECRET 不填则运行时手输 6 位码
FINWEB_USERNAME=
FINWEB_PASSWORD=
FINWEB_TOTP_SECRET=
# 站点根之后的两个前缀（生产 nginx 口径：主后端 /api，资金后端 /fund-api；直连资金后端时改成 /api/v1）
FINWEB_AUTH_PREFIX=/api
FINWEB_FUND_PREFIX=/fund-api

# ── Lark 三表 + 调拨审批（fetch_lark.py）──
# 三表=用户身份 OAuth（user_access_token，2h 过期，`fetch_lark.py --auth` 重授权）；审批=应用身份 tenant_access_token
LARK_API_BASE=https://open.larksuite.com/open-apis
LARK_APP_ID=
LARK_APP_SECRET=
# 一次性 OAuth 回调脚本（起 :3000 收 code 换 token 写 user_token.json）；不填则用 cashflow/oauth_server.py
LARK_OAUTH_SERVER=
LARK_USER_TOKEN_FILE=
# 三张云表格的 spreadsheet token（表格 URL 里 /sheets/<token> 那段）
LARK_SHEET_BANK=
LARK_SHEET_PAY=
LARK_SHEET_BUDGET=
# 「调拨申请（2026.01.04启用）」审批定义的 approval_code
LARK_APPROVAL_CODE_DIAOBO=

# ── 多智能体 demo（demo/multi_agent.py）─────────────────────
# 审批硬限：require_human 档且金额 ≥ 此值 → 直接拒绝，不开人工通道（缺省 120000，原币口径）
DEMO_GATE_HARD_LIMIT=

# ── Embedding（本地模型，首次运行自动下载，无需 API Key）──────
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# ── Qdrant 向量库（本地文件模式）─────────────────────────────
QDRANT_PATH=./qdrant_data
INDUSTRY_COLLECTION=treasury_industry
ENTERPRISE_COLLECTION=treasury_enterprise

# ── 知识库源文件目录 ─────────────────────────────────────────
INDUSTRY_KB_PATH=./knowledge_base/industry
ENTERPRISE_KB_PATH=./knowledge_base/enterprise

# ── 沙箱开关（生产环境改 true 前必须经过安全评审）──────────
BANK_API_ENABLED=false
FX_MARKET_API_ENABLED=false
PAYMENT_MOCK_MODE=true

# ── 审计日志 ─────────────────────────────────────────────────
AUDIT_LOG_PATH=./logs/audit.jsonl
